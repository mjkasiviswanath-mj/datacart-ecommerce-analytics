{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev (Start React Frontend)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http://.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "python: run flask (Start Backend)",
      "type": "shell",
      "command": "python DataCart/app.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "python: init-db (Initialize SQLite Database)",
      "type": "shell",
      "command": "python DataCart/init_db.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "npm: build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "🚀 Start Full Stack (React + Flask)",
      "dependsOn": [
        "npm: dev (Start React Frontend)",
        "python: run flask (Start Backend)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
